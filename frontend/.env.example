# API base URL. Leave unset in dev (Vite proxies /api to localhost:3001).
# VITE_API_URL="https://api.yourdomain.com/api"

# Google Maps key for live bus tracking. Restrict it by HTTP referrer.
# VITE_GOOGLE_MAPS_KEY="AIza..."

# ── White-labelling (dedicated per-school build) ─────────────────────────────
# Leave all unset for the standard Globoniks-branded build. Setting these bakes
# a school's identity into the build itself — including the PWA manifest, which
# cannot vary at runtime. On a shared deployment, per-school branding inside
# the app comes from the signed-in user's school record instead.
# VITE_BRAND_NAME="Sunrise Public School"
# VITE_BRAND_SHORT_NAME="Sunrise"
# VITE_BRAND_TAGLINE="Sunrise Public School"          # empty string hides it
# VITE_BRAND_LOGO_URL="/uploads/<school>/logo.png"
# VITE_BRAND_THEME_COLOR="#0b5d3a"
